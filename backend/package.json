{
  "name": "convoyai-backend",
  "version": "0.0.0",
  "private": true,
  "description": "ConvoyAI backend — Node.js/TypeScript rewrite of the Laravel API (see ../migration/)",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "packageManager": "npm@11",
  "scripts": {
    "dev": "tsx watch src/main.http.ts",
    "dev:worker": "tsx watch src/main.worker.ts",
    "dev:mqtt": "tsx watch src/main.mqtt.ts",
    "dev:scheduler": "tsx watch src/main.scheduler.ts",
    "build": "tsup",
    "start": "node dist/main.http.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "openapi:check": "tsx scripts/openapi-diff.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:timescale": "tsx scripts/run-apply-timescale-migrations.ts",
    "db:manual-migrations": "tsx scripts/run-apply-manual-migrations.ts",
    "db:seed-placeholder-plan": "tsx scripts/run-seed-placeholder-plan.ts",
    "db:seed-platform-operator": "tsx scripts/run-seed-platform-operator.ts",
    "db:seed-demo-data": "tsx scripts/run-seed-demo-data.ts",
    "db:bootstrap": "tsx scripts/bootstrap-db.ts",
    "deploy:prod:up": "docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build",
    "deploy:prod:down": "docker compose -f docker-compose.prod.yml --env-file .env.production down",
    "deploy:prod:logs": "docker compose -f docker-compose.prod.yml --env-file .env.production logs -f",
    "openapi:write": "tsx scripts/openapi-write.ts",
    "openapi:conformance": "tsx scripts/openapi-conformance.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@aws-sdk/client-s3": "^3.1131.0",
    "@prisma/client": "6.19.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "argon2": "^0.45.1",
    "awilix": "^13.0.5",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.4",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "image-size": "^2.0.4",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "mqtt": "^5.15.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.6",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "pm2": "^7.0.4",
    "prisma": "6.19.3",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.10.3",
    "zod": "^4.6.2"
  },
  "//": "Platform set installed 0.7 (walking skeleton); luxon added 1.1 (D-0023); nodemailer added 1.2 (platform/mail, needed for register's verification email); twilio added 2.5 (platform/sms, rule SMS actions); @socket.io/redis-adapter + @socket.io/redis-emitter added 2.6 (D-0067 — main.http.ts and main.worker.ts are separate processes, so a worker-process BullMQ job handler needs a Redis-backed emitter to reach sockets connected on the HTTP process; socket.io-client added as a devDependency for the cross-user isolation integration test). Remaining module-specific dependencies (stripe, etc.) are added per-module from Phase 1 onward, not pre-installed speculatively here. pm2 added Phase 7 (D-0095) — the plain-Node fallback deployment path's process manager (keeps the 4 app processes alive/auto-restarting without Docker), a project dependency rather than requiring a global `npm i -g pm2` on the deploy server; see deploy/DEPLOY.md. cors added Phase 7 (D-0096) — the app had zero CORS handling at all (a real gap, found only once a real browser-based frontend integration test was attempted; every prior live-verification used curl, which isn't subject to CORS); Laravel's own `config/cors.php` had a real explicit-origin allowlist this rewrite had no equivalent of.",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.5",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^5.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0",
    "yaml": "^2.9.1"
  }
}
