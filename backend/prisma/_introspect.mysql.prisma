  companies       companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "vendors_company_id_foreign")

  @@index([company_id], map: "vendors_company_id_index")
}

model widget_settings {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  widget_id        BigInt    @db.UnsignedBigInt
  rule_id          BigInt    @db.UnsignedBigInt
  widget_name      String?   @db.VarChar(255)
  settings         Json?
  attributes       String?   @db.VarChar(255)
  y_axis_label     String?   @db.VarChar(255)
  device           String?   @db.VarChar(255)
  data             String?   @db.VarChar(255)
  unit             String?   @db.VarChar(255)
  icon             String?   @db.VarChar(255)
  decimal          String?   @db.VarChar(255)
  show_timestamp   Boolean?
  product          String?   @db.VarChar(255)
  label            String?   @db.VarChar(255)
  background_color String?   @db.VarChar(255)
  value_color      String?   @db.VarChar(255)
  text_color       String?   @db.VarChar(255)
  max_value        String?   @db.VarChar(255)
  tank_type        String?   @db.VarChar(255)
  graph_type       String?   @db.VarChar(255)
  graph_interval   String?   @db.VarChar(255)
  created_at       DateTime? @db.Timestamp(0)
  updated_at       DateTime? @db.Timestamp(0)
  rules            rules     @relation(fields: [rule_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "widget_settings_rule_id_foreign")
  widgets          widgets   @relation(fields: [widget_id], references: [id], onUpdate: NoAction, map: "widget_settings_widget_id_foreign")

  @@index([rule_id], map: "widget_settings_rule_id_foreign")
  @@index([widget_id], map: "widget_settings_widget_id_foreign")
}

model widgets {
  id                                    BigInt                                  @id @default(autoincrement()) @db.UnsignedBigInt
  dashboard_id                          BigInt?                                 @db.UnsignedBigInt
  type                                  String                                  @db.VarChar(255)
  x                                     Int?
  y                                     Int?
  w                                     Int?
  h                                     Int?
  created_by                            BigInt                                  @db.UnsignedBigInt
  created_at                            DateTime?                               @db.Timestamp(0)
  updated_at                            DateTime?                               @db.Timestamp(0)
  product_attribute_preference_settings product_attribute_preference_settings[]
  widget_settings                       widget_settings[]
  users                                 users                                   @relation(fields: [created_by], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "widgets_created_by_foreign")
  dashboards                            dashboards?                             @relation(fields: [dashboard_id], references: [id], onUpdate: NoAction, map: "widgets_dashboard_id_foreign")

  @@index([created_by], map: "widgets_created_by_foreign")
  @@index([dashboard_id], map: "widgets_dashboard_id_foreign")
}

model yard_layouts {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  yard_id    BigInt    @unique(map: "yard_layouts_yard_id_unique") @db.UnsignedBigInt
  file_path  String    @db.VarChar(255)
  width_px   Int       @db.UnsignedInt
  height_px  Int       @db.UnsignedInt
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  yards      yards     @relation(fields: [yard_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "yard_layouts_yard_id_foreign")
}

model yard_slot_events {
  id             BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  yard_slot_id   BigInt                  @db.UnsignedBigInt
  vehicle_id     BigInt                  @db.UnsignedBigInt
  checked_in_at  DateTime                @db.Timestamp(0)
  checked_out_at DateTime?               @db.Timestamp(0)
  source         yard_slot_events_source @default(manual)
  created_at     DateTime?               @db.Timestamp(0)
  updated_at     DateTime?               @db.Timestamp(0)
  vehicles       vehicles                @relation(fields: [vehicle_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "yard_slot_events_vehicle_id_foreign")
  yard_slots     yard_slots              @relation(fields: [yard_slot_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "yard_slot_events_yard_slot_id_foreign")

  @@index([vehicle_id, checked_out_at], map: "yard_slot_events_vehicle_id_checked_out_at_index")
  @@index([yard_slot_id, checked_out_at], map: "yard_slot_events_yard_slot_id_checked_out_at_index")
}

model yard_slots {
  id               BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  yard_id          BigInt             @db.UnsignedBigInt
  slot_number      String             @db.VarChar(255)
  position_x       Decimal?           @db.Decimal(6, 5)
  position_y       Decimal?           @db.Decimal(6, 5)
  max_length_m     Decimal?           @db.Decimal(5, 2)
  created_at       DateTime?          @db.Timestamp(0)
  updated_at       DateTime?          @db.Timestamp(0)
  yard_slot_events yard_slot_events[]
  yards            yards              @relation(fields: [yard_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "yard_slots_yard_id_foreign")

  @@unique([yard_id, slot_number], map: "yard_slots_yard_id_slot_number_unique")
}

model yards {
  id                 BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  company_id         BigInt               @db.UnsignedBigInt
  name               String               @db.VarChar(255)
  address            String?              @db.Text
  latitude           Decimal?             @db.Decimal(10, 7)
  longitude          Decimal?             @db.Decimal(10, 7)
  created_at         DateTime?            @db.Timestamp(0)
  updated_at         DateTime?            @db.Timestamp(0)
  geofences          geofences[]
  trip_planned_yards trip_planned_yards[]
  yard_layouts       yard_layouts?
  yard_slots         yard_slots[]
  companies          companies            @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "yards_company_id_foreign")

  @@index([company_id], map: "yards_company_id_index")
}

