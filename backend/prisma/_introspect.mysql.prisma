generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("ORACLE_MYSQL_URL")
}

model alarms {
  id                 BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  rule_id            BigInt       @db.UnsignedBigInt
  device_id          BigInt       @db.UnsignedBigInt
  product_id         BigInt?      @db.UnsignedBigInt
  company_id         BigInt?      @db.UnsignedBigInt
  state              alarms_state @default(active)
  condition_snapshot Json?
  triggered_value    Json?
  triggered_at       DateTime     @db.Timestamp(0)
  acknowledged_at    DateTime?    @db.Timestamp(0)
  acknowledged_by    BigInt?      @db.UnsignedBigInt
  cleared_at         DateTime?    @db.Timestamp(0)
  created_at         DateTime?    @db.Timestamp(0)
  updated_at         DateTime?    @db.Timestamp(0)
  users              users?       @relation(fields: [acknowledged_by], references: [id], onUpdate: NoAction, map: "alarms_acknowledged_by_foreign")
  devices            devices      @relation(fields: [device_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "alarms_device_id_foreign")
  rules              rules        @relation(fields: [rule_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "alarms_rule_id_foreign")

  @@index([acknowledged_by], map: "alarms_acknowledged_by_foreign")
  @@index([company_id, state], map: "alarms_company_id_state_index")
  @@index([device_id, state], map: "alarms_device_id_state_index")
  @@index([rule_id, state], map: "alarms_rule_id_state_index")
}

model asset_components {
  id                                                           BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  asset_id                                                     BigInt             @db.UnsignedBigInt
  name                                                         String             @db.VarChar(255)
  icon                                                         String             @db.VarChar(255)
  component_type                                               String?            @db.VarChar(255)
  product_id                                                   String?            @db.VarChar(255)
  device_id                                                    String?            @db.VarChar(255)
  inventory_check                                              String?            @db.VarChar(255)
  parent_id                                                    BigInt?            @db.UnsignedBigInt
  floor_plan_id                                                BigInt?            @db.UnsignedBigInt
  position_x                                                   Decimal?           @db.Decimal(6, 5)
  position_y                                                   Decimal?           @db.Decimal(6, 5)
  created_at                                                   DateTime?          @db.Timestamp(0)
  updated_at                                                   DateTime?          @db.Timestamp(0)
  assets                                                       assets             @relation(fields: [asset_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "asset_components_asset_id_foreign")
  floor_plans_asset_components_floor_plan_idTofloor_plans      floor_plans?       @relation("asset_components_floor_plan_idTofloor_plans", fields: [floor_plan_id], references: [id], onUpdate: NoAction, map: "asset_components_floor_plan_id_foreign")
  asset_components                                             asset_components?  @relation("asset_componentsToasset_components", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "asset_components_parent_id_foreign")
  other_asset_components                                       asset_components[] @relation("asset_componentsToasset_components")
  component_values                                             component_values[]
  floor_plans_floor_plans_asset_component_idToasset_components floor_plans?       @relation("floor_plans_asset_component_idToasset_components")

  @@index([asset_id], map: "asset_components_asset_id_foreign")
  @@index([floor_plan_id], map: "asset_components_floor_plan_id_foreign")
  @@index([parent_id], map: "asset_components_parent_id_foreign")
}

model assets {
  id               BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  name             String             @db.VarChar(255)
  icon             String             @db.VarChar(255)
  type             String             @db.VarChar(255)
  company_id       String?            @db.VarChar(255)
  description      String?            @db.Text
  created_at       DateTime?          @db.Timestamp(0)
  updated_at       DateTime?          @db.Timestamp(0)
  asset_components asset_components[]
}

model billable_events {
  id                BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  company_id        BigInt                 @db.UnsignedBigInt
  trip_id           BigInt                 @db.UnsignedBigInt
  fleet_customer_id BigInt                 @db.UnsignedBigInt
  contract_id       BigInt?                @db.UnsignedBigInt
  rate_card_id      BigInt?                @db.UnsignedBigInt
  event_type        String                 @db.VarChar(255)
  description       String?                @db.Text
  quantity          Decimal                @default(0.0000) @db.Decimal(12, 4)
  unit              String?                @db.VarChar(255)
  unit_rate         Decimal                @default(0.0000) @db.Decimal(10, 4)
  amount            Decimal                @default(0.00) @db.Decimal(12, 2)
  currency          String                 @default("USD") @db.VarChar(3)
  invoice_id        BigInt?                @db.UnsignedBigInt
  status            billable_events_status @default(pending)
  created_at        DateTime?              @db.Timestamp(0)
  updated_at        DateTime?              @db.Timestamp(0)
  companies         companies              @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "billable_events_company_id_foreign")
  contracts         contracts?             @relation(fields: [contract_id], references: [id], onUpdate: NoAction, map: "billable_events_contract_id_foreign")
  fleet_customers   fleet_customers        @relation(fields: [fleet_customer_id], references: [id], onUpdate: NoAction, map: "billable_events_fleet_customer_id_foreign")
  invoices          invoices?              @relation(fields: [invoice_id], references: [id], onUpdate: NoAction, map: "billable_events_invoice_id_foreign")
  rate_cards        rate_cards?            @relation(fields: [rate_card_id], references: [id], onUpdate: NoAction, map: "billable_events_rate_card_id_foreign")
  trips             trips                  @relation(fields: [trip_id], references: [id], onUpdate: NoAction, map: "billable_events_trip_id_foreign")

  @@index([company_id, status], map: "billable_events_company_id_status_index")
  @@index([contract_id], map: "billable_events_contract_id_foreign")
  @@index([fleet_customer_id, status], map: "billable_events_fleet_customer_id_status_index")
  @@index([invoice_id], map: "billable_events_invoice_id_index")
  @@index([rate_card_id], map: "billable_events_rate_card_id_foreign")
  @@index([trip_id], map: "billable_events_trip_id_index")
}

model cache {
  key        String @id @db.VarChar(255)
  value      String @db.MediumText
  expiration Int
}

model cache_locks {
  key        String @id @db.VarChar(255)
  owner      String @db.VarChar(255)
  expiration Int
}

model companies {
  id                     BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  name                   String                   @db.VarChar(255)
  email                  String?                  @unique(map: "companies_email_unique") @db.VarChar(255)
  address                String?                  @db.Text
  city                   String?                  @db.VarChar(255)
  state                  String?                  @db.VarChar(255)
  country                String?                  @db.VarChar(255)
  zip_code               String?                  @db.VarChar(255)
  created_at             DateTime?                @db.Timestamp(0)
  updated_at             DateTime?                @db.Timestamp(0)
  billable_events        billable_events[]
  compliance_documents   compliance_documents[]
  contracts              contracts[]
  drivers                drivers[]
  fleet_customers        fleet_customers[]
  geofences              geofences[]
  invoice_payments       invoice_payments[]
  invoices               invoices[]
  members                members[]
  mqtt_configurations    mqtt_configurations[]
  preconfigure_templates preconfigure_templates[]
  trips                  trips[]
  vehicles               vehicles[]
  vendors                vendors[]
  yards                  yards[]
}

model compliance_documents {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  company_id        BigInt    @db.UnsignedBigInt
  documentable_type String    @db.VarChar(255)
  documentable_id   BigInt    @db.UnsignedBigInt
  document_type     String    @db.VarChar(255)
  document_number   String?   @db.VarChar(255)
  issue_date        DateTime? @db.Date
  expiry_date       DateTime? @db.Date
  file_path         String?   @db.VarChar(255)
  notes             String?   @db.Text
  created_at        DateTime? @db.Timestamp(0)
  updated_at        DateTime? @db.Timestamp(0)
  companies         companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "compliance_documents_company_id_foreign")

  @@index([company_id, expiry_date], map: "compliance_documents_company_id_expiry_date_index")
  @@index([documentable_type, documentable_id], map: "compliance_documents_documentable_type_documentable_id_index")
}

model component_values {
  id                 BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  asset_component_id BigInt           @db.UnsignedBigInt
  value              String?          @db.Text
  created_at         DateTime?        @db.Timestamp(0)
  updated_at         DateTime?        @db.Timestamp(0)
  asset_components   asset_components @relation(fields: [asset_component_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "component_values_asset_component_id_foreign")

  @@index([asset_component_id], map: "component_values_asset_component_id_foreign")
}

model contacts {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String    @db.VarChar(255)
  email      String    @db.VarChar(255)
  subject    String    @db.VarChar(255)
  message    String    @db.Text
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model contracts {
  id                        BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  company_id                BigInt            @db.UnsignedBigInt
  fleet_customer_id         BigInt            @db.UnsignedBigInt
  reference                 String?           @db.VarChar(255)
  pricing_model             String            @db.VarChar(255)
  currency                  String            @default("USD") @db.VarChar(255)
  payment_terms             String?           @db.VarChar(255)
  start_date                DateTime?         @db.Date
  end_date                  DateTime?         @db.Date
  status                    contracts_status  @default(draft)
  sla_terms                 String?           @db.Text
  sla_delivery_window_hours Decimal?          @db.Decimal(5, 2)
  notes                     String?           @db.Text
  created_at                DateTime?         @db.Timestamp(0)
  updated_at                DateTime?         @db.Timestamp(0)
  billable_events           billable_events[]
  companies                 companies         @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "contracts_company_id_foreign")
  fleet_customers           fleet_customers   @relation(fields: [fleet_customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "contracts_fleet_customer_id_foreign")
  invoices                  invoices[]
  rate_cards                rate_cards[]

  @@index([company_id, fleet_customer_id], map: "contracts_company_id_fleet_customer_id_index")
  @@index([fleet_customer_id], map: "contracts_fleet_customer_id_foreign")
}

model customer_locations {
  id                BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  fleet_customer_id BigInt          @db.UnsignedBigInt
  name              String          @db.VarChar(255)
  location_type     String?         @db.VarChar(255)
  address           String?         @db.Text
  latitude          Decimal?        @db.Decimal(10, 7)
  longitude         Decimal?        @db.Decimal(10, 7)
  geofence_id       BigInt?         @db.UnsignedBigInt
  is_active         Boolean         @default(true)
  notes             String?         @db.Text
  created_at        DateTime?       @db.Timestamp(0)
  updated_at        DateTime?       @db.Timestamp(0)
  fleet_customers   fleet_customers @relation(fields: [fleet_customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "customer_locations_fleet_customer_id_foreign")
  geofences         geofences?      @relation(fields: [geofence_id], references: [id], onUpdate: NoAction, map: "customer_locations_geofence_id_foreign")

  @@index([fleet_customer_id], map: "customer_locations_fleet_customer_id_index")
  @@index([geofence_id], map: "customer_locations_geofence_id_foreign")
}

model dashboards {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String    @db.VarChar(255)
  created_by BigInt    @db.UnsignedBigInt
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  users      users     @relation(fields: [created_by], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dashboards_created_by_foreign")
  widgets    widgets[]

  @@index([created_by], map: "dashboards_created_by_foreign")
}

model device_packets {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id      BigInt    @db.UnsignedBigInt
  topic        String    @db.VarChar(255)
  message      String    @db.Text
  parsed_data  Json?
  retained     Boolean   @default(false)
  received_at  DateTime  @db.Timestamp(0)
  processed_at DateTime? @db.Timestamp(0)
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "device_packets_user_id_foreign")

  @@index([user_id], map: "device_packets_user_id_foreign")
}

model device_positions {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  device_id   BigInt    @db.UnsignedBigInt
  latitude    Decimal   @db.Decimal(10, 7)
  longitude   Decimal   @db.Decimal(10, 7)
  speed       Decimal?  @db.Decimal(6, 2)
  heading     Decimal?  @db.Decimal(5, 2)
  recorded_at DateTime  @db.Timestamp(0)
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
  devices     devices   @relation(fields: [device_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "device_positions_device_id_foreign")

  @@index([device_id, recorded_at], map: "device_positions_device_id_recorded_at_index")
}

model device_value_summaries_daily {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  device_id      BigInt    @db.UnsignedBigInt
  attribute_type String    @db.VarChar(255)
  avg            Float?
  day            DateTime  @db.Date
  data_points    Int       @default(0)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)

  @@index([attribute_type], map: "device_value_summaries_daily_attribute_type_index")
  @@index([day], map: "device_value_summaries_daily_day_index")
  @@index([device_id], map: "device_value_summaries_daily_device_id_index")
}

model device_value_summaries_hourly {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  device_id      BigInt    @db.UnsignedBigInt
  attribute_type String    @db.VarChar(255)
  avg            Float?
  hour           DateTime  @db.DateTime(0)
  data_points    Int       @default(0)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)

  @@index([attribute_type], map: "device_value_summaries_hourly_attribute_type_index")
  @@index([device_id], map: "device_value_summaries_hourly_device_id_index")
  @@index([hour], map: "device_value_summaries_hourly_hour_index")
}

model device_value_summaries_monthly {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  device_id      BigInt    @db.UnsignedBigInt
  attribute_type String    @db.VarChar(255)
  avg            Float?
  month          String    @db.VarChar(255)
  data_points    Int       @default(0)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)

  @@index([attribute_type], map: "device_value_summaries_monthly_attribute_type_index")
  @@index([device_id], map: "device_value_summaries_monthly_device_id_index")
  @@index([month], map: "device_value_summaries_monthly_month_index")
}

model device_value_summaries_weekly {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  device_id      BigInt    @db.UnsignedBigInt
  attribute_type String    @db.VarChar(255)
  avg            Float?
  week           String    @db.VarChar(255)
  data_points    Int       @default(0)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)

  @@index([attribute_type], map: "device_value_summaries_weekly_attribute_type_index")
  @@index([device_id], map: "device_value_summaries_weekly_device_id_index")
  @@index([week], map: "device_value_summaries_weekly_week_index")
}

model device_values {
  id                       BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  device_id                BigInt    @db.UnsignedBigInt
  device_unique_identifier String    @db.VarChar(255)
  values                   Json
  created_at               DateTime? @db.Timestamp(0)
  updated_at               DateTime? @db.Timestamp(0)
}

model devices {
  id                         BigInt                       @id @default(autoincrement()) @db.UnsignedBigInt
  device_unique_identifier   String                       @db.VarChar(255)
  name                       String                       @db.VarChar(255)
  type                       String?                      @db.VarChar(255)
  status                     String                       @default("active") @db.VarChar(255)
  location                   String                       @db.VarChar(255)
  tags                       String                       @db.VarChar(255)
  product_id                 BigInt                       @db.UnsignedBigInt
  user_id                    BigInt                       @db.UnsignedBigInt
  created_at                 DateTime?                    @db.Timestamp(0)
  updated_at                 DateTime?                    @db.Timestamp(0)
  alarms                     alarms[]
  device_positions           device_positions[]
  products                   products                     @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "devices_product_id_foreign")
  trips                      trips[]
  user_devices               user_devices[]
  vehicle_device_assignments vehicle_device_assignments[]

  @@index([product_id], map: "devices_product_id_foreign")
}

model driver_incidents {
  id            BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  driver_id     BigInt                    @db.UnsignedBigInt
  vehicle_id    BigInt?                   @db.UnsignedBigInt
  incident_type String                    @db.VarChar(255)
  severity      driver_incidents_severity @default(minor)
  incident_date DateTime                  @db.Date
  description   String?                   @db.Text
  logged_by     BigInt?                   @db.UnsignedBigInt
  created_at    DateTime?                 @db.Timestamp(0)
  updated_at    DateTime?                 @db.Timestamp(0)
  drivers       drivers                   @relation(fields: [driver_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "driver_incidents_driver_id_foreign")
  users         users?                    @relation(fields: [logged_by], references: [id], onUpdate: NoAction, map: "driver_incidents_logged_by_foreign")
  vehicles      vehicles?                 @relation(fields: [vehicle_id], references: [id], onUpdate: NoAction, map: "driver_incidents_vehicle_id_foreign")

  @@index([driver_id, incident_date], map: "driver_incidents_driver_id_incident_date_index")
  @@index([logged_by], map: "driver_incidents_logged_by_foreign")
  @@index([vehicle_id], map: "driver_incidents_vehicle_id_foreign")
}

model driver_vehicle_assignments {
  id                                                    BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  driver_id                                             BigInt    @db.UnsignedBigInt
  vehicle_id                                            BigInt    @db.UnsignedBigInt
  assigned_at                                           DateTime  @db.Timestamp(0)
  unassigned_at                                         DateTime? @db.Timestamp(0)
  assigned_by                                           BigInt?   @db.UnsignedBigInt
  unassigned_by                                         BigInt?   @db.UnsignedBigInt
  notes                                                 String?   @db.VarChar(255)
  trip_count                                            Int       @default(0) @db.UnsignedInt
  distance_km                                           Decimal   @default(0.000) @db.Decimal(10, 3)
  created_at                                            DateTime? @db.Timestamp(0)
  updated_at                                            DateTime? @db.Timestamp(0)
  users_driver_vehicle_assignments_assigned_byTousers   users?    @relation("driver_vehicle_assignments_assigned_byTousers", fields: [assigned_by], references: [id], onUpdate: NoAction, map: "driver_vehicle_assignments_assigned_by_foreign")
  drivers                                               drivers   @relation(fields: [driver_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "driver_vehicle_assignments_driver_id_foreign")
  users_driver_vehicle_assignments_unassigned_byTousers users?    @relation("driver_vehicle_assignments_unassigned_byTousers", fields: [unassigned_by], references: [id], onUpdate: NoAction, map: "driver_vehicle_assignments_unassigned_by_foreign")
  vehicles                                              vehicles  @relation(fields: [vehicle_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "driver_vehicle_assignments_vehicle_id_foreign")

  @@index([assigned_by], map: "driver_vehicle_assignments_assigned_by_foreign")
  @@index([driver_id, unassigned_at], map: "driver_vehicle_assignments_driver_id_unassigned_at_index")
  @@index([unassigned_by], map: "driver_vehicle_assignments_unassigned_by_foreign")
  @@index([vehicle_id, unassigned_at], map: "driver_vehicle_assignments_vehicle_id_unassigned_at_index")
}

model drivers {
  id                         BigInt                       @id @default(autoincrement()) @db.UnsignedBigInt
  company_id                 BigInt                       @db.UnsignedBigInt
  first_name                 String                       @db.VarChar(255)
  last_name                  String                       @db.VarChar(255)
  email                      String?                      @db.VarChar(255)
  phone                      String?                      @db.VarChar(255)
  license_number             String?                      @db.VarChar(255)
  license_class              String?                      @db.VarChar(255)
  license_expiry_date        DateTime?                    @db.Date
  status                     drivers_status               @default(active)
  employment_status          String?                      @db.VarChar(255)
  availability_status        String?                      @db.VarChar(255)
  certifications             Json?
  payroll_reference          String?                      @db.VarChar(255)
  hire_date                  DateTime?                    @db.Date
  photo_path                 String?                      @db.VarChar(255)
  created_at                 DateTime?                    @db.Timestamp(0)
  updated_at                 DateTime?                    @db.Timestamp(0)
  driver_incidents           driver_incidents[]
  driver_vehicle_assignments driver_vehicle_assignments[]
  companies                  companies                    @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "drivers_company_id_foreign")
  trips                      trips[]

  @@index([company_id], map: "drivers_company_id_index")
}

model failed_jobs {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid       String   @unique(map: "failed_jobs_uuid_unique") @db.VarChar(255)
  connection String   @db.Text
  queue      String   @db.Text
  payload    String   @db.LongText
  exception  String   @db.LongText
  failed_at  DateTime @default(now()) @db.Timestamp(0)
}

model failed_mqtt_messages {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id     BigInt    @db.UnsignedBigInt
  topic       String    @db.VarChar(255)
  message     String    @db.Text
  error       String    @db.Text
  retry_count Int       @default(0)
  created_at  DateTime  @default(now()) @db.Timestamp(0)
  retried_at  DateTime? @db.Timestamp(0)

  @@index([user_id, created_at], map: "failed_mqtt_messages_user_id_created_at_index")
}

model fleet_customers {
  id                 BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  company_id         BigInt               @db.UnsignedBigInt
  name               String               @db.VarChar(255)
  customer_type      String?              @db.VarChar(255)
  contact_name       String?              @db.VarChar(255)
  contact_email      String?              @db.VarChar(255)
  contact_phone      String?              @db.VarChar(255)
  billing_address    String?              @db.Text
  tax_number         String?              @db.VarChar(255)
  currency           String               @default("USD") @db.VarChar(255)
  payment_terms      String?              @db.VarChar(255)
  external_crm_id    String?              @db.VarChar(255)
  external_erp_id    String?              @db.VarChar(255)
  is_active          Boolean              @default(true)
  notes              String?              @db.Text
  created_at         DateTime?            @db.Timestamp(0)
  updated_at         DateTime?            @db.Timestamp(0)
  billable_events    billable_events[]
  contracts          contracts[]
