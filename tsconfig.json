{
  // Migration status (task.md Phase 7): src/ is 100% TypeScript. `tsc --noEmit`
  // is clean and enforced by `next build` (typescript.ignoreBuildErrors = false).
  // Files not yet fully typed carry `// @ts-nocheck -- TODO(ts-migration)`.
  //
  // Remaining strict-mode roadmap (measured 2026-09-09, do one at a time):
  //   strictNullChecks  -> ~114 errors to fix
  //   noImplicitAny     -> ~291 errors to fix (or type the @ts-nocheck files first)
  // The other strict-family flags are already on below (they were error-free).
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,

    "strict": false,
    "strictNullChecks": false,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noFallthroughCasesInSwitch": true,

    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@assets/*": ["src/assets/*"],
      "@acl/*": ["src/acl/*"],
      "@components/*": ["src/components/*"],
      "@contexts/*": ["src/contexts/*"],
      "@forms/*": ["src/forms/*"],
      "@hooks/*": ["src/hooks/*"],
      "@layout/*": ["src/layout/*"],
      "@locales/*": ["src/locales/*"],
      "@pages/*": ["src/screens/*"],
      "@screens/*": ["src/screens/*"],
      "@root/*": ["./*"],
      "@utils/*": ["src/utils/*"],
      "@validation/*": ["src/validation/*"],
      "@lib/*": ["src/lib/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next", "dist", "out"]
}
